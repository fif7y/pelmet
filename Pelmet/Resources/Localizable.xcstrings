    "Its shortcut, aliases and history moved to Search.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kürzel, die Aliasse und der Verlauf findest du jetzt unter „Suche“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su atajo, sus alias y su historial ahora están en Búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son raccourci, ses alias et son historique sont passés dans Recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scorciatoia, gli alias e la cronologia ora sono in Ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット、別名、履歴は「検索」に移動しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키, 별칭, 기록은 ‘검색’으로 옮겨졌습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atalho, os apelidos e o histórico agora ficam em Busca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание, псевдонимы и история теперь в разделе «Поиск»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键、别名和历史记录已移至“搜索”。"
          }
        }
      }
    },
    "Keeps the groups you made in the menu bar apart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Gruppen, die du in der Menüleiste gebildet hast, getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene separados los grupos que hiciste en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde séparés les groupes que vous avez faits dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene separati i gruppi che hai creato nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーで作ったグループを分けて表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 만든 그룹을 서로 떨어뜨려 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém separados os grupos que você criou na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держит раздельно группы, которые вы сделали в строке меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你在菜单栏中建立的分组彼此分开。"
          }
        }
      }
    },
    "Keeps the groups you made in the menu bar together, one row each.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Gruppen, die du in der Menüleiste gebildet hast, zusammen, je eine Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene juntos los grupos que hiciste en la barra de menús, una fila cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ensemble les groupes que vous avez faits dans la barre des menus, une rangée chacun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene insieme i gruppi che hai creato nella barra dei menu, una riga ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーで作ったグループをまとめ、1グループ1行で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 만든 그룹을 한 줄에 하나씩 모아 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém juntos os grupos que você criou na barra de menus, uma linha cada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держит вместе группы, которые вы сделали в строке меню, по ряду на каждую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
