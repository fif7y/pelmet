    "Show or hide your icons without reaching for the mouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole ein- oder ausblenden, ohne zur Maus zu greifen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta tus iconos sin tocar el ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez ou masquez vos icônes sans toucher la souris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nascondi le icone senza toccare il mouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスに手を伸ばさずにアイコンを表示・非表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스에 손대지 않고 아이콘을 보이거나 숨기세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre ou oculte seus ícones sem pegar o mouse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывайте или скрывайте значки, не тянувшись к мыши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需伸手拿鼠标即可显示或隐藏图标。"
          }
        }
      }
    },
    "Show or hide your icons, edit the layout, switch the animation, check for updates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole ein- oder ausblenden, Anordnung bearbeiten, Animation wechseln, nach Updates suchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar u ocultar tus iconos, editar la disposición, cambiar la animación, buscar actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher ou masquer vos icônes, modifier la disposition, changer l’animation, rechercher des mises à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nascondi le tue icone, modifica la disposizione, cambia l’animazione, cerca aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンの表示/非表示、配置の編集、アニメーションの切り替え、アップデートの確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 표시/숨김, 배치 편집, 애니메이션 전환, 업데이트 확인."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar ou ocultar seus ícones, editar a disposição, trocar a animação, buscar atualizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать или скрыть значки, изменить раскладку, переключить анимацию, проверить обновления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示或隐藏图标、编辑布局、切换动画、检查更新。"
          }
        }
      }
    },
