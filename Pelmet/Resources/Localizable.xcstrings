{
  "sourceLanguage": "en",
  "strings": {
    "%@ already opens %@. Press a different combination.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet bereits %@. Drücke eine andere Kombination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya abre %@. Pulsa otra combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre déjà %@. Appuyez sur une autre combinaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apre già %@. Premi un’altra combinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに %@ を開きます。別の組み合わせを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 는 이미 %@ 을(를) 엽니다. 다른 조합을 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já abre %@. Pressione outra combinação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже открывает %@. Нажмите другое сочетание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已用于打开 %@。请按其他组合。"
          }
        }
      }
    },
    "%@ ignores the moves Pelmet makes in the bar, so it keeps its own spot. Hold ⌘ and drag it yourself, or give it a launcher.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignoriert die Verschiebungen, die Pelmet in der Leiste macht, und behält seinen Platz. Halte ⌘ und zieh es selbst, oder gib ihm einen Starter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignora los movimientos que Pelmet hace en la barra y conserva su sitio. Mantén ⌘ y arrástralo tú mismo, o dale un lanzador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignore les déplacements que Pelmet fait dans la barre et garde sa place. Maintiens ⌘ et déplace-le toi-même, ou donne-lui un lanceur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignora gli spostamenti che Pelmet fa nella barra e tiene il suo posto. Tieni premuto ⌘ e trascinala tu, oppure dalle un avvio app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はPelmetがバーで行う移動を無視し、自分の位置を保ちます。⌘を押しながら自分でドラッグするか、ランチャーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) Pelmet이 막대에서 하는 이동을 무시하고 제자리를 지킵니다. ⌘를 누른 채 직접 드래그하거나 실행기를 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignora os movimentos que o Pelmet faz na barra e mantém o seu lugar. Segure ⌘ e arraste você mesmo, ou dê a ele um atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ игнорирует перемещения, которые Pelmet делает в строке меню, и остаётся на своём месте. Удерживайте ⌘ и перетащите её сами или добавьте для неё запуск."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会忽略 Pelmet 在菜单栏中的移动，保持自己的位置。按住 ⌘ 自行拖动，或为它添加一个启动器。"
          }
        }
      }
    },
    "%@ is already Pelmet's shortcut for “%@”. Press a different combination.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits das Pelmet-Kürzel für „%@“. Drücke eine andere Kombination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya es el atajo de Pelmet para «%@». Pulsa otra combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà le raccourci de Pelmet pour « %@ ». Appuyez sur une autre combinaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già la scorciatoia di Pelmet per «%@». Premi un’altra combinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに Pelmet の「%@」のショートカットです。別の組み合わせを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 는 이미 Pelmet의 “%@” 단축키입니다. 다른 조합을 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já é o atalho do Pelmet para “%@”. Pressione outra combinação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже используется в Pelmet для «%@». Нажмите другое сочетание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已是 Pelmet 的“%@”快捷键。请按其他组合。"
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %@"
          }
        },
        "es": {
