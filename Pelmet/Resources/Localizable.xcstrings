          }
        }
      }
    },
    "Pinned by macOS — Pelmet can hide it, but not move it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von macOS fixiert – Pelmet kann es ausblenden, aber nicht bewegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijado por macOS: Pelmet puede ocultarlo, pero no moverlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
