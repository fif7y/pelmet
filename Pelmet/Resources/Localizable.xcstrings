    "Click, then press the new shortcut. ⌫ turns it off, ⎋ cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, dann das neue Kürzel drücken. ⌫ schaltet es aus, ⎋ bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic y pulsa el nuevo atajo. ⌫ lo desactiva, ⎋ cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez, puis tapez le nouveau raccourci. ⌫ le désactive, ⎋ annule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic, poi premi la nuova scorciatoia. ⌫ la disattiva, ⎋ annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックしてから新しいショートカットを押します。⌫ でオフ、⎋ でキャンセル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭한 뒤 새 단축키를 누르세요. ⌫ 는 끄기, ⎋ 는 취소입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique e pressione o novo atalho. ⌫ o desativa, ⎋ cancela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
