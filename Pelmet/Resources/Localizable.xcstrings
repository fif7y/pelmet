    "Gone for good, unless you double-click or ⌥-click the chevron": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauerhaft weg, außer bei Doppelklick oder ⌥-Klick auf den Chevron"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultos del todo, salvo con doble clic o ⌥-clic en el chevrón"
