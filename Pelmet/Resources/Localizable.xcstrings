    "Out of the way, back with a hover or a click": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Weg, mit Hover oder Klick wieder da"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de la vista, vuelven al pasar el cursor o hacer clic"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors de vue, de retour d'un survol ou d'un clic"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dai piedi, tornano con un passaggio del mouse o un clic"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段は非表示、ホバーかクリックで戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소엔 숨기고, 올리거나 클릭하면 돌아옵니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora do caminho, voltam com um hover ou um clique"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убраны с глаз, возвращаются наведением или щелчком"
