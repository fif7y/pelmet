        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 재생 중 표시(종료 후 몇 분간 유지). 클릭으로 재생/일시정지, 오른쪽 클릭으로 트랙 이동"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece enquanto toca áudio (fica alguns minutos depois): clique para tocar/pausar, clique direito para as faixas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается во время воспроизведения (и ещё несколько минут после): щелчок — пуск/пауза, правый щелчок — треки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
