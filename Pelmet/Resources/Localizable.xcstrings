    "Forget the pending order changes; the editor shows the bar as it is": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Reihenfolge-Änderungen verwerfen; der Editor zeigt die Leiste wie sie ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar los cambios de orden pendientes; el editor muestra la barra tal cual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier les changements d’ordre en attente ; l’éditeur montre la barre telle quelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarta le modifiche d’ordine in sospeso; l’editor mostra la barra com’è"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
