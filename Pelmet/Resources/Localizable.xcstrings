    "Pelmet-made stand-ins for the system extras — these live in any section": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Pelmet gebaute Ersatzsymbole für die System-Extras – sie passen in jeden Bereich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustitutos hechos por Pelmet para los extras del sistema: caben en cualquier sección"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des doublures Pelmet pour les extras système : elles vont dans n’importe quelle section"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
