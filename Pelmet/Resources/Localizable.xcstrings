    "Type a few letters, press Return, and you're in that icon's menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Buchstaben tippen, Return drücken, und du bist im Menü des Symbols."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe unas letras, pulsa Retorno y estarás en el menú de ese icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez quelques lettres, appuyez sur Retour, et vous êtes dans le menu de l’icône."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi qualche lettera, premi Invio e sei nel menu di quell’icona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数文字入力してReturnを押すだけで、そのアイコンのメニューが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 글자를 입력하고 Return을 누르면 해당 아이콘의 메뉴가 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite algumas letras, pressione Return e você já está no menu daquele ícone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пару букв, нажмите Return — и вы в меню нужного значка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入几个字母，按下回车，即可进入该图标的菜单。"
          }
        }
      }
    },
    "Type shortcut…": {
      "localizations": {
        "de": {
