    "Try it: click the chevron.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier es aus: Klick auf den Pfeil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo: haz clic en el chevrón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez : cliquez sur le chevron."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova: fai clic sulla freccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試してみましょう：シェブロンをクリック。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해 보기: 화살표를 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente: clique na seta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте: нажмите на стрелку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试一试：点按箭头。"
          }
        }
      }
    },
    "Try it: drag the panel's left edge, right-click it, or click it and type.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier es aus: Zieh am linken Rand des Panels, klick es mit rechts an oder klick hinein und tippe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo: arrastra el borde izquierdo del panel, haz clic derecho en él, o haz clic y escribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez : faites glisser le bord gauche du panneau, faites un clic droit dessus, ou cliquez dedans et tapez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova: trascina il bordo sinistro del pannello, fai clic destro, oppure fai clic e digita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試してみましょう：パネルの左端をドラッグ、右クリック、またはクリックして入力。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해 보기: 패널 왼쪽 가장자리를 드래그하거나, 오른쪽 클릭하거나, 클릭한 뒤 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente: arraste a borda esquerda do painel, clique com o botão direito nele, ou clique e digite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте: потяните левый край панели, нажмите на неё правой кнопкой или щёлкните и печатайте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试一试：拖移面板左边缘、右键点按它，或点按后输入。"
          }
        }
      }
    },
    "Try it: right-click it, or click it and type.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier es aus: Klick es mit rechts an oder klick hinein und tippe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo: haz clic derecho en ella, o haz clic y escribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez : faites un clic droit dessus, ou cliquez dedans et tapez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova: fai clic destro, oppure fai clic e digita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試してみましょう：右クリック、またはクリックして入力。"
          }
