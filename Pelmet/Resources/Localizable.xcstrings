          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisations"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizzazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissões"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешения"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限"
          }
        }
      }
    },
    "Physically arranges the bar to match the sections — icons that sit out of place slide their neighbors on every reveal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet die Leiste physisch nach den Bereichen – falsch platzierte Symbole verschieben bei jedem Einblenden ihre Nachbarn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena físicamente la barra según las secciones: los iconos fuera de sitio desplazan a sus vecinos en cada aparición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganise physiquement la barre selon les sections : les icônes mal placées décalent leurs voisines à chaque affichage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina fisicamente la barra secondo le sezioni: le icone fuori posto spostano le vicine a ogni comparsa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セクションに合わせてバーを実際に並べ替えます。位置がずれたアイコンは表示のたびに隣のアイコンを動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섹션에 맞게 막대를 실제로 재배치합니다. 위치가 어긋난 아이콘은 표시될 때마다 이웃을 밀어냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorganiza fisicamente a barra conforme as seções: ícones fora do lugar deslocam os vizinhos a cada revelação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Физически выстраивает строку по секциям: значки не на своём месте сдвигают соседей при каждом показе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按分区实际重排菜单栏，位置不当的图标每次显示时都会推挤相邻图标。"
          }
        }
      }
    },
    "Pick Panel or Row to set names, columns and groups.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Panel oder Zeile, um Namen, Spalten und Gruppen einzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Panel o Fila para ajustar nombres, columnas y grupos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Panneau ou Rangée pour régler les noms, les colonnes et les groupes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Pannello o Riga per impostare nomi, colonne e gruppi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、列数、グループを設定するには、パネルか横一列を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름, 열, 그룹을 설정하려면 패널이나 한 줄을 고르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Painel ou Linha para ajustar nomes, colunas e grupos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Панель» или «Ряд», чтобы настроить названия, столбцы и группы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“面板”或“单行”即可设置名称、列数和分组。"
          }
        }
      }
    },
    "Pinned by macOS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von macOS fixiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijado por macOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglé par macOS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissato da macOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSにより固定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 고정함"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixado pelo macOS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплено macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
