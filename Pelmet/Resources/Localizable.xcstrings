{
  "sourceLanguage": "en",
  "strings": {
    "A hover or click away — or ⌘-drag icons left of the chevron": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Überfahren oder Klick entfernt – oder Symbole mit ⌘ links neben den Chevron ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A un paso del cursor o un clic; o arrastra iconos con ⌘ a la izquierda del chevrón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À un survol ou un clic : ou glissez des icônes à gauche du chevron avec ⌘"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A un passaggio del cursore o a un clic; oppure trascina le icone con ⌘ a sinistra del chevron"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホバーかクリックで表示。または⌘を押しながらアイコンをシェブロンの左へドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스를 올리거나 클릭하면 표시. 또는 ⌘를 누른 채 아이콘을 쉐브론 왼쪽으로 드래그"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A um passar de cursor ou clique; ou arraste ícones com ⌘ para a esquerda do chevron"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показ по наведению или щелчку; либо перетащите значки левее шеврона с ⌘"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停或点击即可显示，也可按住 ⌘ 将图标拖到尖角符号左侧"
          }
        }
      }
    },
