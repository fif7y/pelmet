    "Auto picks a width that fits your icons. You can also drag the panel's edge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch wählt eine Breite, die zu deinen Symbolen passt. Du kannst auch am Rand des Panels ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático elige un ancho que se ajusta a tus iconos. También puedes arrastrar el borde del panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto choisit une largeur adaptée à vos icônes. Vous pouvez aussi faire glisser le bord du panneau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto sceglie una larghezza adatta alle tue icone. Puoi anche trascinare il bordo del pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動にすると、アイコンに合った幅を選びます。パネルの端をドラッグして変えることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 아이콘에 맞는 너비를 고릅니다. 패널 가장자리를 드래그할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático escolhe uma largura que cabe seus ícones. Você também pode arrastar a borda do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» подбирает ширину под ваши значки. Можно также потянуть край панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会选择适合你图标的宽度。你也可以拖移面板边缘。"
          }
        }
      }
    },
