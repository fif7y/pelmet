    "Play, pause and switch tracks without leaving the bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abspielen, pausieren und Titel wechseln, ohne die Leiste zu verlassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce, pausa y cambia de pista sin salir de la barra."
          }
        },
