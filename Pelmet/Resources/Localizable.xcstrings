          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 순서 변경을 잊고 편집기는 현재 막대를 그대로 표시합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
