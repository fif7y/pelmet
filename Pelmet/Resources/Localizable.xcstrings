    "System icon — Pelmet places it; whether it exists in the bar is set in System Settings › Control Center": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemsymbol – Pelmet platziert es; ob es in der Leiste erscheint, wird in Systemeinstellungen › Kontrollzentrum festgelegt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Icono del sistema: Pelmet lo coloca; si aparece en la barra se decide en Ajustes del Sistema › Centro de control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icône système : Pelmet la place ; sa présence dans la barre se règle dans Réglages Système › Centre de contrôle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
