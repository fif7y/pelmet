    "Press ↩ to save, ⎋ to cancel. Leave it empty to remove the alias.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ speichert, ⎋ bricht ab. Leer lassen, um den Alias zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ guarda, ⎋ cancela. Déjalo vacío para quitar el alias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ enregistre, ⎋ annule. Laissez vide pour retirer l’alias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ salva, ⎋ annulla. Lascia vuoto per rimuovere l’alias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ で保存、⎋ でキャンセル。空にすると別名を削除します。"
