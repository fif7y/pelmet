    "Everything at once, press again to hide it all.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles auf einmal, erneut drücken blendet alles aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo a la vez, pulsa de nuevo para ocultarlo todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout d'un coup, appuyez à nouveau pour tout masquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto insieme, premi di nuovo per nascondere tutto."
