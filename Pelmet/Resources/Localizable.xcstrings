    "Shows while audio plays (lingers a few minutes after) — click plays/pauses, right-click for tracks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint bei Audiowiedergabe (bleibt danach einige Minuten) – Klick für Wiedergabe/Pause, Rechtsklick für Titel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece mientras suena audio (permanece unos minutos después): clic para reproducir/pausar, clic derecho para las pistas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaît pendant la lecture audio (reste quelques minutes après) : clic pour lecture/pause, clic droit pour les pistes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare durante la riproduzione audio (resta qualche minuto dopo): clic per riproduci/pausa, clic destro per i brani"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の再生中に表示（終了後も数分残ります）。クリックで再生/一時停止、右クリックで曲送り"
          }
